# --- Cloud (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
WHISPER_MODEL=whisper-large-v3-turbo
ROMANIZE_MODEL=openai/gpt-oss-20b

# --- Local (Ollama + whisper docker) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=deepseek-r1:1.5b
# Whisper runs in docker (no host install). Matches ASR_MODEL below.
LOCAL_WHISPER_API_URL=http://127.0.0.1:9000
LOCAL_WHISPER_LANGUAGE=hi
# Opt-in legacy path only: LOCAL_WHISPER_MODE=cli + LOCAL_WHISPER_CMD=whisper
# LOCAL_WHISPER_MODE=http
# LOCAL_WHISPER_CMD=whisper
# LOCAL_WHISPER_MODEL=base

# --- Whisper docker service (compose `local` profile) ---
ASR_MODEL=base
ASR_ENGINE=faster_whisper

# --- Web ---
# Points the Vite dev proxy / production build at one of the servers.
# VITE_API_URL=http://127.0.0.1:3000
